<figure><a href="/images/cs180/project-2/dog-x.png"><img src="/images/cs180/project-2/dog-x.png" width="20" height="19" loading="lazy" alt="DoG x filter: 19 × 20"></a><figcaption>DoG x filter: 19 × 20</figcaption></figure>
<figure><a href="/images/cs180/project-2/dog-y.png"><img src="/images/cs180/project-2/dog-y.png" width="19" height="20" loading="lazy" alt="DoG y filter: 20 × 19"></a><figcaption>DoG y filter: 20 × 19</figcaption></figure>
</div>
<div class="p2-grid p2-cols-1">
