---
title: Isabel Dong
permalink: /index.html
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title }}</title>
  <base href="/">
  <link rel="icon" href="images/favicon.ico" type="image/x-icon">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <div class="page-wrapper" id="page-wrapper">
  <div class="container">
    <header class="fade-in">
      <div class="header-left">
        <div class="site-title"><a href="/">Isabel Dong</a></div>
        <nav>
          <a href="/" aria-current="page">Home</a>
          <a href="/work/">Work</a>
          <a href="/shelf/">Shelf</a>
        </nav>
      </div>
      <button class="theme-toggle" onclick="toggleTheme()" title="Toggle dark mode">
        <span class="theme-icon">☀</span>
      </button>
    </header>

    <main>
      <div class="hero-image fade-in">
        <img src="images/header.jpeg" alt="">
      </div>

      <div class="page-content home-content fade-in">
        <section class="about-section">
          <h1 class="section-title">About Me</h1>

          <p class="label">//now//</p>
          <ul>
            {%- for item in about.now %}
            <li>{{ item.text }} <a href="{{ item.link }}" target="_blank">{{ item.linkText }}</a>{{ item.suffix }}</li>
            {%- endfor %}
          </ul>

          <p class="label">//previously//</p>
          <ul>
            {%- for item in about.previously %}
            <li>{{ item.text }} <a href="{{ item.link }}">{{ item.linkText }}</a>{% if item.link2 %}{{ item.suffix }} <a href="{{ item.link2 }}">{{ item.linkText2 }}</a>{% elif item.suffix %} {{ item.suffix }}{% endif %}</li>
            {%- endfor %}
          </ul>

          <p class="label">//lore//</p>
          <ul>
            {%- for item in about.lore %}
            <li>{% if item.html %}{{ item.html | safe }}{% else %}<a href="{{ item.link }}">{{ item.linkText }}</a>{% endif %}</li>
            {%- endfor %}
          </ul>
        </section>
      </div>
    </main>

    <footer>
      <div>thx for reading</div>
    </footer>
  </div>
  </div>

  <script>
    function toggleTheme() {
      const wrapper = document.getElementById('page-wrapper');
      const nextTheme = wrapper.classList.contains('dark-mode') ? 'light' : 'dark';
      wrapper.classList.toggle('dark-mode', nextTheme === 'dark');
      localStorage.setItem('theme', nextTheme);
      updateThemeIcon(nextTheme);
    }

    function updateThemeIcon(theme) {
      document.querySelector('.theme-icon').textContent = theme === 'dark' ? '☽' : '☀';
    }

    function loadTheme() {
      const savedTheme = localStorage.getItem('theme') || 'light';
      document.getElementById('page-wrapper').classList.toggle('dark-mode', savedTheme === 'dark');
      updateThemeIcon(savedTheme);
    }

    document.addEventListener('DOMContentLoaded', loadTheme);
  </script>
</body>
</html>
