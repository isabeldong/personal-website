---
layout: base.njk
title: Work | Isabel Dong
pageKey: work
permalink: /work/index.html
---
<main class="page-content work-content fade-in">
  <h1 class="page-title">Work</h1>

  <div class="work-grid">
    <section class="work-column">
      <h2 class="work-column-title">//experience//</h2>
      <ul class="work-list experience-list">
        {%- for item in experience %}
        <li>
          <button class="experience-trigger" type="button" aria-haspopup="dialog" onclick="openExperienceModal(experience[{{ loop.index0 }}], this)">
            <span class="work-item-title">{{ item.organization }}</span>
            <span class="work-item-description">{{ item.role }}</span>
            <span class="experience-open" aria-hidden="true">+</span>
          </button>
        </li>
        {%- endfor %}
      </ul>
    </section>

    <section class="work-column">
      <h2 class="work-column-title">//projects//</h2>
      <ul class="work-list projects-list">
        {%- for item in projects %}
        <li>
          {% if item.url %}<a class="work-item-title" href="{{ item.url }}" target="_blank">{{ item.title }}</a>{% else %}<span class="work-item-title">{{ item.title }}</span>{% endif %}
          <div class="work-item-description">{{ item.description }}</div>
          <div class="work-item-meta work-item-meta-uppercase">{{ item.source }}{% if item.year %} · {{ item.year }}{% endif %}</div>
        </li>
        {%- endfor %}
      </ul>
    </section>

    <section class="work-column coursework-column">
      <h2 class="work-column-title">//coursework//</h2>
      <div class="coursework-groups">
        {%- for group in coursework %}
        <section class="coursework-group">
          <h3 class="coursework-group-title">{{ group.category }}</h3>
          <ul class="work-list coursework-list">
            {%- for course in group.courses %}
            <li>
              <span class="work-item-title">{% if course.inProgress %}*{% endif %}{{ course.code }}</span>
              <div class="course-title">{{ course.title }}</div>
            </li>
            {%- endfor %}
          </ul>
        </section>
        {%- endfor %}
      </div>
      <p class="coursework-legend">* = In Progress</p>
    </section>
  </div>
</main>

<div class="modal-overlay" id="experience-modal">
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="experience-modal-title">
    <button class="modal-close" id="experience-modal-close" type="button" onclick="closeExperienceModal()" aria-label="Close experience details">×</button>
    <div class="modal-title" id="experience-modal-title"></div>
    <div class="modal-author" id="experience-modal-role"></div>
    <div class="modal-review" id="experience-modal-description"></div>
  </div>
</div>

<script>
  const experience = {{ experience | dump | safe }};
  let lastExperienceTrigger = null;

  function openExperienceModal(item, trigger) {
    lastExperienceTrigger = trigger;
    document.getElementById('experience-modal-title').textContent = item.organization;
    document.getElementById('experience-modal-role').textContent = item.role;
    document.getElementById('experience-modal-description').textContent = item.description || 'Description coming soon.';
    document.getElementById('experience-modal').classList.add('active');
    document.body.style.overflow = 'hidden';
    document.getElementById('experience-modal-close').focus();
  }

  function closeExperienceModal() {
    document.getElementById('experience-modal').classList.remove('active');
    document.body.style.overflow = '';
    if (lastExperienceTrigger) lastExperienceTrigger.focus();
  }

  document.getElementById('experience-modal').addEventListener('click', function(event) {
    if (event.target === this) closeExperienceModal();
  });

  document.addEventListener('keydown', function(event) {
    if (event.key === 'Escape') closeExperienceModal();
  });
</script>
